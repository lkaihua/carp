{
  "compilerOptions": {
    "jsx": "react-jsx", // enables JSX for React 17+ (or "react" for older)
    "esModuleInterop": true, // common for imports
    "moduleResolution": "bundler", // required for module lookup
    "module": "esnext", // modern module output
    "target": "esnext", // modern JS target
    "allowSyntheticDefaultImports": true,
    "types": ["vite/client"] // keep Vite type declarations
  },
  "include": ["src"]
}
